<?xml version="1.0" encoding="utf-8"?>
<selector xmlns:android="http://schemas.android.com/apk/res/android">

    <item android:state_focused="true">
        <shape android:shape="rectangle">
            <solid android:color="@color/tv_accent" />
            <corners android:radius="10dp" />
            <stroke android:width="2dp" android:color="@color/tv_button_focused" />
            <padding
                android:bottom="14dp"
                android:left="20dp"
                android:right="20dp"
                android:top="14dp" />
        </shape>
    </item>

    <item>
        <shape android:shape="rectangle">
            <solid android:color="@color/tv_overlay" />
            <corners android:radius="10dp" />
            <stroke android:width="2dp" android:color="@color/tv_button_normal" />
            <padding
                android:bottom="14dp"
                android:left="20dp"
                android:right="20dp"
                android:top="14dp" />
        </shape>
    </item>

</selector>
